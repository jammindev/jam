{
  "name": "jam",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "pnpm --filter @jam/desktop dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
