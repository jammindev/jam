    "check": "pnpm typecheck && pnpm test && pnpm build",
    "core:ping": "pnpm --filter @jam/core ping"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
